def welcome():
  print("Boa tarde!")
  print("1 - 🍔 Cheeseburger")
  print("2 - 🍟 Fries")
  print("3 - 🥤 Soda")
  print("4 - 🍦 Ice Cream")
  print("5 - 🍪 Cookie")

def get_item(number):
  if number == 1:
    return('🍔 Cheeseburger')
  elif number == 2:
    return('🍟 Fries')
  elif number == 3:
    return('🥤 Soda')
  elif number == 4:
    return('🍦 Ice Cream')
  elif number == 5:
    return('🍪 Cookie')
  else:
    return('Item inválido')

welcome()

escolha = int(input("Escolha o seu pedido: "))

item = get_item(escolha)

print("Você pediu:", item)
